# Diretório de trabalho do Terraform
.terraform/

# State
*.tfstate
*.tfstate.*

# Planos salvos (podem conter segredos)
tfplan*
*.tfplan

# Variáveis e backend com valores reais; só os *.example são versionados
*.tfvars
terraform.tfvars
*.auto.tfvars
backend.hcl
!*.tfvars.example

# Logs de falha
crash.log
crash.*.log

# Overrides locais
override.tf
*_override.tf
