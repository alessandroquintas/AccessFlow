generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum RoleSystemKey {
  OWNER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum IntegrationClientStatus {
  ACTIVE
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model Organization {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  status             OrganizationStatus  @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  integrationClients IntegrationClient[]
  invitations        Invitation[]
  roles              Role[]
  customPermissions  CustomPermission[]
  auditEvents        AuditEvent[]

  @@map("organizations")
}

model Role {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  description    String?
  systemKey      RoleSystemKey? @map("system_key")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  // Um OWNER e um MEMBER por organização. Papéis customizados têm
  // system_key NULL, e o Postgres não considera NULLs iguais entre si.
  @@unique([organizationId, systemKey])
  // Alvo das FKs compostas: membership e convite só apontam para papel da
  // própria organização.
  @@unique([id, organizationId])
  @@map("roles")
}

// Permissões que a organização define (`recurso:ação`). As de sistema ficam
// no código. role_permissions guarda só a chave, como texto: a integridade
// vem da trava da organização e da checagem de uso antes de excluir.
model CustomPermission {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  description    String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("organization_permissions")
}

// O OWNER não tem linhas aqui: tem todas as permissões, calculadas no código.
model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model IntegrationClient {
  id             String                  @id @default(uuid()) @db.Uuid
  clientId       String                  @unique @map("client_id")
  organizationId String                  @map("organization_id") @db.Uuid
  name           String
  status         IntegrationClientStatus @default(ACTIVE)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("integration_clients")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, createdAt, id])
  @@index([roleId, organizationId])
  @@map("memberships")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  roleId          String           @map("role_id") @db.Uuid
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)

  // Listagem da organização e contagem do limite de pendentes.
  @@index([organizationId, status, createdAt, id])
  // myInvitations.
  @@index([email, status])
  @@index([invitedByUserId])
  @@index([roleId, organizationId])
  @@map("invitations")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  cognitoSub      String       @unique @map("cognito_sub")
  name            String
  email           String
  status          UserStatus   @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships     Membership[]
  invitationsSent Invitation[]
  auditEvents     AuditEvent[]

  // inviteMember (ALREADY_MEMBER) e myInvitations buscam por e-mail.
  @@index([email])
  @@map("users")
}

enum AuditActorType {
  USER
  MACHINE
  SYSTEM
}

// Trilha de auditoria administrativa: só INSERT. O trigger que recusa UPDATE e
// DELETE e o CHECK de coerência do ator estão na migration (o Prisma não os
// representa). action e target_type são texto, validados no código.
model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  actorClientId  String?        @map("actor_client_id")
  action         String
  targetType     String         @map("target_type")
  targetId       String         @map("target_id")
  details        Json
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(3)
  // X-Request-Id da requisição que gerou o evento; nulo fora de requisição.
  requestId      String?        @map("request_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  // Listagem da organização, do mais recente para o mais antigo.
  @@index([organizationId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("audit_events")
}

// Cada resposta 200 do POST /v1/authorize. O CHECK do results e o da
// coerência do allowed estão na migration.
model AuthorizationDecision {
  id             String   @id @default(uuid()) @db.Uuid
  // Sem FK: o KEY SHARE da FK faria o authorize esperar qualquer ação
  // administrativa em andamento na organização (motivo na migration).
  organizationId String   @map("organization_id") @db.Uuid
  // Sem FK: o registro fica mesmo que a integração deixe de existir.
  clientId       String   @map("client_id")
  // Sem FK: o sujeito pode nem existir como usuário.
  subjectUserId  String   @map("subject_user_id") @db.Uuid
  // [{ permission, allowed }], na ordem do pedido.
  results        Json
  allowed        Boolean
  requestId      String?  @map("request_id")
  decidedAt      DateTime @map("decided_at") @db.Timestamptz(3)

  // Listagem da organização, da mais recente para a mais antiga.
  @@index([organizationId, decidedAt(sort: Desc), id(sort: Desc)])
  // O mesmo, filtrado por sujeito ("por que fulano foi negado?").
  @@index([organizationId, subjectUserId, decidedAt(sort: Desc), id(sort: Desc)], map: "authorization_decisions_organization_id_subject_user_id_idx")
  @@map("authorization_decisions")
}

enum SecurityActorType {
  USER
  MACHINE
}

// Tentativas de acesso negadas. Sem FK em nenhuma coluna (motivo na
// migration). O CHECK de coerência do ator e o do details estão na
// migration. event é texto, validado no código.
model SecurityEvent {
  id             String            @id @default(uuid()) @db.Uuid
  // Nulo em evento de máquina de client não cadastrado.
  organizationId String?           @map("organization_id") @db.Uuid
  actorType      SecurityActorType @map("actor_type")
  actorUserId    String?           @map("actor_user_id") @db.Uuid
  actorClientId  String?           @map("actor_client_id")
  event          String
  details        Json
  // X-Request-Id da requisição negada; nulo fora de requisição.
  requestId      String?           @map("request_id")
  occurredAt     DateTime          @map("occurred_at") @db.Timestamptz(3)

  // Listagem da organização, do mais recente para o mais antigo.
  @@index([organizationId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("security_events")
}
